{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "types": []
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
